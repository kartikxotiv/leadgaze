{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true pnpm run build",
    "build": "pnpm with-env next build",
    "build:test": "NODE_ENV=test pnpm with-env:test next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev --turbo | pino-pretty -c",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "start": "pnpm with-env next start",
    "start:test": "NODE_ENV=test pnpm with-env:test next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ./.env.local --",
    "with-env:test": "dotenv -e ./.env.test --",
    "supabase": "supabase",
    "supabase:start": "supabase status || supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:test": "supabase db test",
    "supabase:db:lint": "supabase db lint",
    "supabase:deploy": "supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push",
    "supabase:typegen": "supabase gen types typescript --project-id carwrljcvuzabktofqmt --schema public --schema hrms --schema core --schema service_cloud > ../../packages/supabase/src/database.types.ts",
    "supabase:db:dump:local": "supabase db dump --local --data-only",
    "supabase:migration:applied": "supabase migration repair --status applied <timestamp>",
    "test:pricing": "node --experimental-transform-types lib/pricing.test.mjs",
    "test:pricing:concurrency": "node lib/entitlements/concurrency.integration.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@edge-csrf/nextjs": "2.5.3-cloudflare-rc1",
    "@hookform/resolvers": "^5.2.2",
    "@kit/accounts": "workspace:*",
    "@kit/auth": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/fund-raise": "workspace:*",
    "@kit/hrms": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@kit/integration-core": "workspace:*",
    "@kit/integration-google": "workspace:*",
    "@kit/integration-google-ads": "workspace:*",
    "@kit/integration-meta-ads": "workspace:*",
    "@kit/integration-website": "workspace:*",
    "@kit/integration-whatsapp": "workspace:*",
    "@kit/integration-zapier": "workspace:*",
    "@kit/integration-zoom": "workspace:*",
    "@kit/inventory": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/sales": "workspace:*",
    "@kit/service-cloud": "workspace:*",
    "@kit/shared": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/ui": "workspace:*",
    "@makerkit/data-loader-supabase-core": "^0.0.10",
    "@makerkit/data-loader-supabase-nextjs": "^1.2.5",
    "@marsidev/react-turnstile": "^1.3.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "2.75.0",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.1.0",
    "imapflow": "^1.2.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.545.0",
    "mailparser": "^3.9.6",
    "next": "15.5.9",
    "next-sitemap": "^4.2.3",
    "next-themes": "0.4.6",
    "nodemailer": "^7.0.12",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.0.0",
    "recharts": "2.15.3",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@kit/eslint-config": "workspace:*",
    "@kit/prettier-config": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@next/bundle-analyzer": "15.5.7",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.7.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.37.0",
    "pino-pretty": "13.0.0",
    "prettier": "^3.6.2",
    "supabase": "^2.48.3",
    "tailwindcss": "4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "prettier": "@kit/prettier-config",
  "browserslist": [
    "last 1 versions",
    "> 0.7%",
    "not dead"
  ]
}

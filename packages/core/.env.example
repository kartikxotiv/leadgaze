# Core package environment variables
#
# These values are read at runtime by the host app that imports @kit/core.
# In the web app, define them in apps/web/.env.local or your deployment env.

# Required for encrypting/decrypting stored SMTP, IMAP, and OAuth credentials.
# Must be exactly 32 bytes when interpreted as UTF-8.
# Example generation:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url').slice(0, 32))"
ENCRYPTION_KEY=

# Required for Gmail / Google Workspace account connection and OAuth sending.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for Google OAuth redirect URL construction.
# Example: http://localhost:3000 or https://app.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Optional: SMTP/IMAP account credentials are supplied per workspace in the UI,
# not through environment variables.
